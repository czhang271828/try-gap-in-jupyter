#!/usr/bin/env bash

set -e

# ensure bash
if [ -z "$BASH_VERSION" ]; then
    exec bash "$0" "$@"
fi

# GAP root
GAP_DIR="/usr/local/gap"

KERNEL_DIR="$GAP_DIR/pkg/JupyterKernel"
KERNEL_SCRIPT="$KERNEL_DIR/bin/jupyter-kernel.py"

# Build JupyterKernel (this creates bin/jupyter-kernel.py)
if [ ! -f "$KERNEL_SCRIPT" ]; then
    echo "Building GAP JupyterKernel..."
    cd "$KERNEL_DIR"
    ./configure "$GAP_DIR"
    make
fi

# Install kernel into Jupyter
exec "$KERNEL_SCRIPT" "$@"
